{
  "name": "pm-assistant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm -r test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/db/src/types.ts",
    "seed:demo": "node --env-file=packages/db/.env.local scripts/seed-demo.mjs",
    "reset:demo": "node --env-file=packages/db/.env.local scripts/seed-demo.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "postgres": "^3.4.9",
    "supabase": "^2.101.0"
  }
}
