# apps/web — copy to .env.local (gitignored) for local dev.
# These are PUBLIC (client-exposed) values: the anon key is safe to ship,
# RLS enforces tenant isolation. See docs/ENV.md.

# Supabase project URL + anon key (Project settings → API).
PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
PUBLIC_SUPABASE_ANON_KEY="your-local-anon-key"

# Base URL of the deployed Worker (Approve & Send posts to ${PUBLIC_WORKER_URL}/api/drafts/:id/send).
PUBLIC_WORKER_URL="http://127.0.0.1:8787"

# Optional — drives dev banners / feature flags.
PUBLIC_ENVIRONMENT="development"
